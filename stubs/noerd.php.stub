<?php

return [
    /*
    |--------------------------------------------------------------------------
    | Authentication
    |--------------------------------------------------------------------------
    |
    | Noerd registers its own auth guard, user provider and password broker
    | at runtime — config/auth.php is never modified. Any of the keys that
    | already exist in the host's auth config are left untouched, so a host
    | can override every part by defining it itself.
    |
    | 'guard'          Guard noerd authenticates against. Set to 'web' to
    |                  run on the host's default guard instead of a dedicated one.
    | 'model'          Authenticatable model backing the noerd user provider.
    | 'set_as_default' When true, noerd also becomes the app's DEFAULT guard
    |                  at runtime — escape hatch for hosts with unmigrated
    |                  bare-'auth' routes. Leave false when noerd coexists
    |                  with another auth stack (Nova, Breeze, ...).
    |
    */
    'auth' => [
        'guard' => env('NOERD_AUTH_GUARD', 'noerd'),
        'model' => env('NOERD_AUTH_MODEL', Noerd\Models\NoerdUser::class),
        'provider' => 'noerd_users',
        'passwords' => 'noerd_users',
        'set_as_default' => env('NOERD_AUTH_DEFAULT', false),
    ],

    /*
    |--------------------------------------------------------------------------
    | Routes
    |--------------------------------------------------------------------------
    |
    | URL prefix for the noerd core routes (login, apps, user, ...). Route
    | NAMES are unaffected — only the URLs carry the prefix, so navigation
    | and route() calls keep working when the prefix changes. The /setup
    | area keeps its own prefix and is not affected.
    |
    */
    'routes' => [
        'prefix' => env('NOERD_ROUTE_PREFIX', 'noerd'),
    ],

    /*
    |--------------------------------------------------------------------------
    | Feature Flags
    |--------------------------------------------------------------------------
    |
    | Enable or disable specific features of the Noerd package.
    |
    */
    'features' => [
        'multi_tenant' => env('NOERD_MULTI_TENANT', true),
        'new_tenant' => env('NOERD_NEW_TENANT_FEATURE_ENABLED', true),
        'currency' => env('NOERD_CURRENCY_ENABLED', true),
    ],

    /*
    |--------------------------------------------------------------------------
    | Collection Definitions (Setup area)
    |--------------------------------------------------------------------------
    |
    | Controls where the schemas of the SETUP collections are stored. The CMS
    | module is unaffected — its collection definitions always live in the
    | database (cms collection_definitions table).
    |
    | Supported modes:
    |   - "yaml":     Schemas live in setup_yaml_path as committed YAML files.
    |                 The management UI is hidden. Changes are deployed as files.
    |   - "database": Schemas live per tenant in setup_collection_definitions.
    |                 The management UI is enabled, and a newly created tenant
    |                 is seeded from the YAML source. Migrate an existing
    |                 installation with:
    |                 php artisan noerd:setup-collections:import-yaml --all-tenants
    |
    | The navigation flag noerd.collections.show_definitions_ui is DERIVED from
    | this value at boot — do not set it here.
    |
    */
    'collections' => [
        'mode' => env('NOERD_COLLECTIONS_MODE', 'yaml'),
        'setup_yaml_path' => 'app-configs/setup/collections',
    ],

    /*
    |--------------------------------------------------------------------------
    | Currency
    |--------------------------------------------------------------------------
    |
    | The installation-wide default currency (ISO 4217, one of
    | Noerd\Helpers\CurrencyHelper::CURRENCIES). A tenant overrides it in
    | Setup → System Settings; every amount in the system is an amount in the
    | tenant currency.
    |
    */
    'currency' => [
        'default' => env('NOERD_CURRENCY', 'EUR'),
    ],

    /*
    |--------------------------------------------------------------------------
    | Display Formats
    |--------------------------------------------------------------------------
    |
    | Number, date and currency FORMATTING (ICU). The locale is resolved per
    | reader: the user's profile locale → the tenant locale (Setup → System
    | Settings, also used for every document) → `locale` below → the default
    | locale of the interface language (Noerd\Support\Locales). The remaining
    | keys pin a format for the whole installation and win over the locale.
    |
    */
    'format' => [
        'locale' => env('NOERD_FORMAT_LOCALE'),
        'date' => env('NOERD_FORMAT_DATE'),
        'datetime' => env('NOERD_FORMAT_DATETIME'),
        'decimal_separator' => env('NOERD_FORMAT_DECIMAL_SEPARATOR'),
