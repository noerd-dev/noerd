    public ?string $detailPrimary = '{{entity}}Id';

    public $detailModel = {{ModelBaseName}}::class;
}; ?>

<x-noerd::page>
    <x-slot:header>
        <x-noerd::modal-title>{{ __('{{ModelTitle}}') }}</x-noerd::modal-title>
