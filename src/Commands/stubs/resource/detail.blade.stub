<?php

use Livewire\Component;
use Noerd\Traits\NoerdDetail;
use {{ModelClass}};

new class extends Component {
    use NoerdDetail;

    public $detailModel = {{ModelBaseName}}::class;

    public ?string $detailPrimary = '{{entity}}Id';
}; ?>

<x-noerd::page>
    <x-slot:header>
        <x-noerd::modal-title>{{ __('{{ModelTitle}}') }}</x-noerd::modal-title>
    </x-slot:header>

    <x-noerd::tab-content :layout="$pageLayout" :modelId="$modelId" />

    <x-slot:footer>
        <x-noerd::delete-save-bar :showDelete="isset($modelId)"/>
    </x-slot:footer>
</x-noerd::page>
