<?php

declare(strict_types=1);

namespace Noerd\{{ModuleName}}\Commands;

use Illuminate\Console\Command;
use Noerd\Commands\Concerns\HasModuleInstallation;

class {{ModuleName}}InstallCommand extends Command
{
    use HasModuleInstallation;

    protected $signature = 'noerd:install-{{module-name}}';

    protected $description = 'Install {{ModuleName}} module content and navigation';

    protected function getModuleName(): string
    {
        return '{{ModuleName}}';
    }

    protected function getModuleKey(): string
    {
        return '{{module-name}}';
    }

    protected function getDefaultAppTitle(): string
    {
        return '{{AppTitle}}';
    }

    protected function getAppIcon(): string
    {
        return '{{app-icon}}';
    }

    protected function getAppRoute(): string
    {
        return '{{module-name}}';
    }

    protected function getSourceDir(): string
    {
        return dirname(__DIR__, 2) . '/app-configs/{{module-name}}';
    }
}
