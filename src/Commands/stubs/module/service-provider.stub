<?php

declare(strict_types=1);

namespace Noerd\{{ModuleName}}\Providers;

use Illuminate\Support\ServiceProvider;
use Livewire\Livewire;
use Noerd\{{ModuleName}}\Commands\{{ModuleName}}InstallCommand;
use Noerd\{{ModuleName}}\Commands\{{ModuleName}}UpdateCommand;

class {{ModuleName}}ServiceProvider extends ServiceProvider
{
    public function boot(): void
    {
        $this->loadMigrationsFrom(__DIR__ . '/../../database/migrations');
        $this->loadViewsFrom(__DIR__ . '/../../resources/views', '{{module-name}}');
        Livewire::addNamespace('{{module-name}}', viewPath: __DIR__ . '/../../resources/views/components');
        $this->loadJsonTranslationsFrom(__DIR__ . '/../../resources/lang');
        $this->loadRoutesFrom(__DIR__ . '/../../routes/{{module-name}}-routes.php');

        if ($this->app->runningInConsole()) {
            $this->commands([
                {{ModuleName}}InstallCommand::class,
                {{ModuleName}}UpdateCommand::class,
            ]);
        }
    }
}
