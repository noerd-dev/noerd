			path: src/Services/RelationFieldRegistry.php

		-
			message: '#^Call to function is_string\(\) with class\-string\<Illuminate\\Database\\Eloquent\\Model\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Services/RelationTitleResolver.php

		-
			message: '#^Call to function in_array\(\) with arguments ''Austria''\|''Belgium''\|''Czech Republic''\|''France''\|''Germany''\|''Italy''\|''Luxembourg''\|''Netherlands''\|''Poland''\|''Spain''\|''Switzerland''\|''United Kingdom''\|''United States'', array\{\} and true will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: src/Support/DefaultCountries.php

		-
			message: '#^Call to function in_array\(\) with arguments ''Belgien''\|''Deutschland''\|''Frankreich''\|''Italien''\|''Luxemburg''\|''Niederlande''\|''Polen''\|''Schweiz''\|''Spanien''\|''Tschechien''\|''Vereinigte Staaten''\|''Vereinigtes…''\|''Österreich'', array\{\} and true will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: src/Support/DefaultCountries.php

		-
			message: '#^Offset ''code'' on string\|null on left side of \?\? does not exist\.$#'
			identifier: nullCoalesce.offset
