			identifier: nullCoalesce.offset
			count: 1
			path: src/Support/DefaultCountries.php

		-
			message: '#^Strict comparison using \!\=\= between null and ''AT''\|''BE''\|''CH''\|''CZ''\|''DE''\|''ES''\|''FR''\|''GB''\|''IT''\|''LU''\|''NL''\|''PL''\|''US'' will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Support/DefaultCountries.php

		-
			message: '#^Strict comparison using \=\=\= between null and ''AT''\|''BE''\|''CH''\|''CZ''\|''DE''\|''ES''\|''FR''\|''GB''\|''IT''\|''LU''\|''NL''\|''PL''\|''US'' will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: src/Support/DefaultCountries.php

		-
			message: '#^Call to function is_array\(\) with array\<string, mixed\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: src/Support/LayoutFields.php

		-
			message: '#^Instanceof between Noerd\\Support\\Positions\\PositionColumn and Noerd\\Support\\Positions\\PositionColumn will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 2
			path: src/Support/Positions/PositionColumnResolver.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
