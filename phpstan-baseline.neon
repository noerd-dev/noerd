parameters:
	ignoreErrors:
		-
			message: '#^Offset ''component'' on array\{component\: string, app\?\: string, apps\?\: array\<string\>, policy\?\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Commands/Concerns/WritesHostAppConfigs.php

		-
			message: '#^Method Noerd\\Commands\\MakeCollectionCommand\:\:askForField\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Commands/MakeCollectionCommand.php

		-
			message: '#^Call to function method_exists\(\) with Noerd\\Models\\NoerdUser and ''currentProfile'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Helpers/AccessHelper.php

		-
			message: '#^Call to function method_exists\(\) with Noerd\\Models\\NoerdUser and ''isAdmin'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Helpers/AccessHelper.php

		-
			message: '#^Using nullsafe property access "\?\-\>id" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Helpers/FormatHelper.php

		-
			message: '#^Method Noerd\\Helpers\\NoerdAuth\:\:user\(\) should return Noerd\\Models\\NoerdUser\|null but returns Illuminate\\Foundation\\Auth\\User\|null\.$#'
			identifier: return.type
			count: 1
			path: src/Helpers/NoerdAuth.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$id\.$#'
