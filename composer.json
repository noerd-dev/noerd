{
    "name": "noerd/noerd",
    "description": "",
    "type": "library",
    "version": "v0.8.4",
    "license": "MIT",
    "require": {
        "livewire/livewire": "^4.0",
        "noerd/modal": "^0.3",
        "composer/composer": "^2.9",
        "wireui/heroicons": "^2.9",
        "symfony/yaml": "^7.1 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.6",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Noerd\\": "src/",
            "Noerd\\Tests\\": "tests/",
            "Noerd\\Database\\Factories\\": "database/factories/",
            "Noerd\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Noerd\\Providers\\NoerdServiceProvider"
            ]
        }
    }
}