{
    "name": "noerd/noerd",
    "description": "YAML-driven Livewire framework for multi-tenant Laravel applications: generic list, detail and page components, modals, themes, tenant apps and install/update tooling.",
    "type": "library",
    "keywords": [
        "laravel",
        "livewire",
        "framework",
        "multi-tenant",
        "yaml",
        "admin",
        "crud"
    ],
    "homepage": "https://noerd.dev",
    "authors": [
        {
            "name": "Johannes Brock"
        }
    ],
    "version": "v0.14.7",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "livewire/livewire": "^4.0",
        "noerd/modal": "^0.3.23",
        "symfony/polyfill-mbstring": "^1.32",
        "symfony/yaml": "^7.1 || ^8.0",
        "wireui/heroicons": "^2.9"
    },
    "require-dev": {
        "orchestra/testbench": "^10.6 || ^11.1",
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.18"
    },
    "suggest": {
        "owen-it/laravel-auditing": "Required for the activity log modal (noerd::audit-list) of auditable models."
    },
    "autoload": {
        "psr-4": {
            "Noerd\\": "src/",
            "Noerd\\Tests\\": "tests/",
            "Noerd\\Database\\Factories\\": "database/factories/",
            "Noerd\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "files": [
            "tests/helpers.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Noerd\\Providers\\NoerdServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test"
    }
}
